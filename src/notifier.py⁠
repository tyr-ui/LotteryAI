"""Send the generated LotteryAI notification summary to Discord."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
from typing import Mapping
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


DISCORD_CONTENT_LIMIT = 2000
DEFAULT_CHUNK_LIMIT = 1900


class NotificationConfigurationError(RuntimeError):
    """Raised when required notification configuration is missing."""


class NotificationDeliveryError(RuntimeError):
    """Raised when Discord rejects or cannot receive a notification."""


def _required_env(
    name: str,
    environ: Mapping[str, str] | None = None,
) -> str:
    source = os.environ if environ is None else environ
    value = str(source.get(name, "")).strip()
    if not value:
        raise NotificationConfigurationError(
            f"Required environment variable is missing: {name}"
        )
    return value


def split_discord_messages(
    text: str,
    *,
    limit: int = DEFAULT_CHUNK_LIMIT,
) -> list[str]:
    """Split Markdown into Discord-safe messages while preserving lines."""
    if limit <= 0 or limit > DISCORD_CONTENT_LIMIT:
        raise ValueError(
            f"limit must be between 1 and {DISCORD_CONTENT_LIMIT}."
        )

    normalized = text.strip()
    if not normalized:
        raise ValueError("Notification summary is empty.")

    chunks: list[str] = []
    current = ""

    for line in normalized.splitlines():
        pieces = [
            line[index:index + limit]
            for index in range(0, len(line), limit)
        ] or [""]

        for piece in pieces:
            separator = "\n" if current else ""
            candidate = current + separator + piece

            if len(candidate) <= limit:
                current = candidate
                continue

            if current:
                chunks.append(current)
            current = piece

    if current:
        chunks.append(current)

    return chunks


def _post_discord_message(
    webhook_url: str,
    content: str,
    *,
    username: str = "LotteryAI",
    timeout: float = 20.0,
) -> None:
    payload = json.dumps(
        {
            "content": content,
            "username": username,
            "allowed_mentions": {"parse": []},
        },
        ensure_ascii=False,
    ).encode("utf-8")

    request = Request(
        webhook_url,
        data=payload,
        headers={
            "Content-Type": "application/json; charset=utf-8",
            "User-Agent": "LotteryAI-Notifier/1.0",
        },
        method="POST",
    )

    try:
        with urlopen(request, timeout=timeout) as response:
            status = int(getattr(response, "status", 204))
            if status not in {200, 204}:
                raise NotificationDeliveryError(
                    f"Discord webhook returned HTTP {status}."
                )
    except HTTPError as exc:
        raise NotificationDeliveryError(
            f"Discord webhook returned HTTP {exc.code}."
        ) from exc
    except URLError as exc:
        raise NotificationDeliveryError(
            f"Discord webhook request failed: {exc.reason}"
        ) from exc


def send_notification_discord(
    summary_path: Path,
    *,
    webhook_url: str,
    username: str = "LotteryAI",
    chunk_limit: int = DEFAULT_CHUNK_LIMIT,
) -> int:
    """Send a Markdown summary to Discord, split into safe message chunks."""
    if not summary_path.is_file():
        raise FileNotFoundError(
            f"Notification summary was not found: {summary_path}"
        )

    body = summary_path.read_text(encoding="utf-8")
    chunks = split_discord_messages(body, limit=chunk_limit)

    for index, chunk in enumerate(chunks, start=1):
        if len(chunks) > 1:
            prefix = f"**LotteryAI通知 {index}/{len(chunks)}**\n"
            available = DISCORD_CONTENT_LIMIT - len(prefix)
            content = prefix + chunk[:available]
        else:
            content = chunk

        _post_discord_message(
            webhook_url,
            content,
            username=username,
        )

    return len(chunks)


def send_from_environment(
    summary_path: Path,
    *,
    environ: Mapping[str, str] | None = None,
) -> int:
    source = os.environ if environ is None else environ
    webhook_url = _required_env(
        "LOTTERY_DISCORD_WEBHOOK",
        source,
    )
    username = str(
        source.get("LOTTERY_DISCORD_USERNAME", "LotteryAI")
    ).strip() or "LotteryAI"

    return send_notification_discord(
        summary_path,
        webhook_url=webhook_url,
        username=username,
    )


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Send the LotteryAI notification summary to Discord."
    )
    parser.add_argument(
        "summary_path",
        nargs="?",
        default="output/notification_summary.md",
    )
    args = parser.parse_args()

    count = send_from_environment(Path(args.summary_path))
    print(f"Discord notification sent: {count} message(s)")


if __name__ == "__main__":
    main()
